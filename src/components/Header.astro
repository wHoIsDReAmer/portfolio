---
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const { pathname } = Astro.url;

const links = [
	{ href: base, label: 'Home' },
	{ href: `${base}contact`, label: 'Contact' },
	{ href: 'https://blog.devcw.xyz', label: 'Blog', external: true },
];

const isActive = (href: string) => pathname.replace(/\/$/, '') === href.replace(/\/$/, '');
---

<header class="flex items-center justify-between py-10">
	<a href={base} class="text-lg font-bold tracking-tight hover:text-accent transition-colors">
		이찬욱
	</a>

	<nav class="flex items-center gap-5">
		{
			links.map(({ href, label, external }) => (
				<a
					href={href}
					target={external ? '_blank' : undefined}
					rel={external ? 'noopener noreferrer' : undefined}
					class:list={[
						'text-sm transition-colors hover:text-accent',
						isActive(href) ? 'text-fg' : 'text-muted',
					]}
				>
					{label}
				</a>
			))
		}
		<ThemeToggle />
	</nav>
</header>
