---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import ProjectList from '../components/project/ProjectList.svelte';
import RecordShelf from '../components/music/RecordShelf.astro';
import { projects } from '../constants/projects';

const stack = [
	'Rust',
	'Go',
	'TypeScript',
	'Java',
	'PostgreSQL',
	'Redis',
	'Kafka',
	'gRPC',
	'AWS',
	'Vue',
	'Svelte',
];

const socials = [
	{ label: 'GitHub', href: 'https://github.com/wHoIsDReAmer' },
	{ label: 'Blog', href: 'https://velog.io/@devcw' },
	{ label: 'Email', href: 'mailto:neverprogrammer@gmail.com' },
];
---

<Layout title="이찬욱">
	<Section title="About">
		<div class="space-y-3 text-[0.92rem] leading-relaxed [word-break:keep-all]">
			<p>컴퓨터 과학을 사랑하고, 근본을 이해하는 것을 즐기는 소프트웨어 엔지니어입니다.</p>
			<p class="text-muted">
				주로 백엔드와 시스템, 개발 도구를 만듭니다. 하이레벨, 로우레벨 모두 좋아합니다.
			</p>
		</div>

		<div class="mt-5 flex flex-wrap gap-x-4 gap-y-1">
			{
				socials.map(({ label, href }) => (
					<a
						href={href}
						target="_blank"
						rel="noopener noreferrer"
						class="text-sm text-muted underline decoration-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
					>
						{label}
					</a>
				))
			}
		</div>
	</Section>

	<Section title="Stack">
		<ul class="flex flex-wrap gap-x-2 gap-y-2">
			{
				stack.map((item) => (
					<li class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">
						{item}
					</li>
				))
			}
		</ul>
	</Section>

	<Section title="Works">
		<ProjectList projects={projects} client:visible />
	</Section>

	<Section title="Record Shelf">
		<RecordShelf />
	</Section>
</Layout>
