---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';

const channels = [
	{ label: 'Email', value: 'neverprogrammer@gmail.com', href: 'mailto:neverprogrammer@gmail.com' },
	{ label: 'Phone', value: '010-6496-9410', href: 'tel:+821064969410' },
	{ label: 'GitHub', value: 'wHoIsDReAmer', href: 'https://github.com/wHoIsDReAmer' },
	{ label: 'Blog', value: 'velog.io/@devcw', href: 'https://velog.io/@devcw' },
];
---

<Layout title="Contact — 이찬욱">
	<Section title="Contact">
		<p class="mb-7 text-[0.92rem] leading-relaxed text-muted [word-break:keep-all]">
			하고 싶은 이야기가 있다면 편하게 연락주세요.
		</p>

		<dl class="divide-y divide-line border-y border-line">
			{
				channels.map(({ label, value, href }) => (
					<div class="flex items-baseline gap-4 py-3">
						<dt class="w-16 flex-none text-xs uppercase tracking-wide text-muted">{label}</dt>
						<dd>
							<a
								href={href}
								target={href.startsWith('http') ? '_blank' : undefined}
								rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
								class="text-sm transition-colors hover:text-accent"
							>
								{value}
							</a>
						</dd>
					</div>
				))
			}
		</dl>
	</Section>
</Layout>
